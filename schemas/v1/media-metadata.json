{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MediaMetadataItem",
  "description": "An item of the reserved _media collection. id = the media file's virtual path.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "description": "Readable output file name (slug); defaults to the original file name" },
    "translations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "alt": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "focalPoint": { "$ref": "#/definitions/point" },
    "focalPoints": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/point" }
    },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "variants": {
      "type": "array",
      "description": "Sizes rendered at publish for the targets' presets; each is a media file of the release",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "preset": { "type": "string", "minLength": 1 },
          "breakpoint": { "type": "string", "minLength": 1 },
          "dpr": { "type": "number", "exclusiveMinimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "format": { "enum": ["avif", "webp", "jpeg", "png"] }
        },
        "required": ["path", "preset", "breakpoint", "dpr", "width", "height", "format"],
        "additionalProperties": true
      }
    }
  },
  "definitions": {
    "point": {
      "type": "object",
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["x", "y"],
      "additionalProperties": true
    }
  },
  "required": ["id"],
  "additionalProperties": true
}
