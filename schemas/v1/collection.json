{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Collection",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "collection": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "key": { "type": "string" },
          "translations": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "media": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": true
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "collection": { "type": "string" },
                "id": { "type": "string" }
              },
              "required": ["collection", "id"],
              "additionalProperties": true
            }
          },
          "media": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "_provenance": {
            "type": "object",
            "properties": {
              "translations": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/definitions/provenanceMarker" }
                }
              },
              "fields": {
                "type": "object",
                "additionalProperties": { "$ref": "#/definitions/provenanceMarker" }
              }
            },
            "additionalProperties": true
          }
        },
        "required": ["id", "key", "translations"],
        "additionalProperties": true
      }
    }
  },
  "definitions": {
    "provenanceMarker": {
      "type": "object",
      "properties": {
        "status": { "enum": ["original", "human", "machine", "reviewed"] },
        "from": { "type": "string" },
        "sourceHash": { "type": "string" },
        "model": { "type": "string" }
      },
      "required": ["status"],
      "additionalProperties": true
    }
  },
  "required": ["schemaVersion", "collection", "items"],
  "additionalProperties": true
}
