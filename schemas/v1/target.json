{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TargetDefinition",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "locales": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "minCompleteness": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxStale": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "collections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "minItems": { "type": "integer", "minimum": 0 },
          "localized": { "type": "object" },
          "fields": { "type": "object" },
          "presets": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "collection": { "type": "string" },
          "key": { "type": "string" }
        },
        "required": ["collection", "key"],
        "additionalProperties": true
      }
    },
    "recommendations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "localized": { "type": "object" },
          "fields": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "breakpoints": {
          "type": "object",
          "description": "Breakpoint name -> minimum screen width in CSS pixels",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "dpr": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
        "presets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "aspect": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?:[0-9]+(\\.[0-9]+)?$" },
              "fit": { "enum": ["fill", "fit"] },
              "widths": {
                "type": "object",
                "description": "Breakpoint name -> rendered width in CSS pixels",
                "additionalProperties": { "type": "integer", "minimum": 1 }
              },
              "formats": {
                "type": "array",
                "description": "Formats to render; the last one is the universal fallback",
                "items": { "enum": ["avif", "webp", "jpeg", "png"] },
                "minItems": 1,
                "uniqueItems": true
              },
              "quality": { "type": "integer", "minimum": 1, "maximum": 100 },
              "lossless": { "type": "boolean" },
              "background": { "type": "string" }
            },
            "required": ["widths"],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "required": ["id"],
  "additionalProperties": true
}
