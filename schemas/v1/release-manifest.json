{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReleaseManifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "releaseId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "collections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "hash": { "type": "string" },
          "itemCount": { "type": "integer", "minimum": 0 },
          "size": { "type": "integer", "minimum": 0 }
        },
        "required": ["hash", "itemCount", "size"],
        "additionalProperties": true
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "hash": { "type": "string" },
          "size": { "type": "integer", "minimum": 0 },
          "mimeType": { "type": "string" }
        },
        "required": ["hash", "size", "mimeType"],
        "additionalProperties": true
      }
    },
    "translations": {
      "type": "object",
      "properties": {
        "sourceLocale": { "type": "string" },
        "locales": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/translationCounts" }
        },
        "overall": { "$ref": "#/definitions/translationCounts" }
      },
      "required": ["sourceLocale", "locales", "overall"],
      "additionalProperties": true
    },
    "targets": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "definitions": {
    "translationCounts": {
      "type": "object",
      "properties": {
        "expected": { "type": "integer", "minimum": 0 },
        "translated": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "stale": { "type": "integer", "minimum": 0 },
        "machine": { "type": "integer", "minimum": 0 }
      },
      "required": ["expected", "translated", "missing", "stale", "machine"],
      "additionalProperties": true
    }
  },
  "required": ["schemaVersion", "releaseId", "createdAt", "collections", "media"],
  "additionalProperties": true
}
