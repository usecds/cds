{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChannelManifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "channel": {
      "type": "string"
    },
    "releaseId": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["schemaVersion", "channel", "releaseId", "updatedAt"],
  "additionalProperties": false
}
