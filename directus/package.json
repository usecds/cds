{
  "name": "@usecds/directus",
  "version": "0.1.0",
  "description": "Directus adapter for CDS: a content source for publishing, and a Directus-compatible read API over a synced CDS release",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./compat": "./dist/compat.js",
    "./source": "./dist/source.js",
    "./editor": "./dist/editor.js",
    "./content-types": "./dist/content-types.js"
  },
  "bin": {
    "cds-directus-publish": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@usecds/client": "workspace:*",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@usecds/server": "workspace:*"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usecds/cds.git",
    "directory": "directus"
  },
  "publishConfig": {
    "access": "public"
  }
}
