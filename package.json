{
  "name": "usecds",
  "private": true,
  "version": "0.1.0",
  "description": "Content Decoupling System: frontends that work with any CMS backend, without ever talking to it.",
  "scripts": {
    "build": "pnpm --filter=server build && pnpm --filter=client build && pnpm --filter=imaging build && pnpm --filter=@usecds/s3 build && pnpm --filter=@usecds/directus build",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test -c e2e/playwright.config.ts",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "demo": "pnpm build && pnpm --filter=@usecds/demo generate",
    "demo:serve": "pnpm build && pnpm --filter=@usecds/demo serve",
    "demo:images": "pnpm build && pnpm --filter=@usecds/demo images"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usecds/cds.git"
  }
}
