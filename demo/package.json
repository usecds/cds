  },
  "dependencies": {
    "@cds/client": "workspace:*",
    "@cds/imaging": "workspace:*",
    "@cds/server": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "node-html-markdown": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
