{
  "name": "@usecds/client",
  "version": "0.2.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "worker": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "workerd": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "deno": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prepare": "node -e \"require('node:fs').cpSync('../schemas', 'schemas', { recursive: true })\" && tsc",
    "validators": "node scripts/validators.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usecds/cds.git",
    "directory": "client"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "schemas"
  ]
}
